-- Sales revenue, AOV and order performance by year
WITH performance AS (
SELECT
    YEAR(sales.order_date) AS time_year,
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS revenue,
    ROUND(SUM(products.unit_price_usd * sales.quantity) / COUNT(DISTINCT sales.order_number), 0) AS AOV,
    COUNT(DISTINCT sales.order_number) AS orders_count
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
WHERE YEAR(sales.order_date) < 2021
GROUP BY YEAR(sales.order_date))

SELECT
    AVG(revenue),
    AVG(AOV),
    AVG(orders_count)
FROM performance;

-- Sales revenue, AOV and order growth rates by year
WITH performance AS (
SELECT
    YEAR(sales.order_date) AS time_year,
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS revenue,
    ROUND(SUM(products.unit_price_usd * sales.quantity) / COUNT(DISTINCT sales.order_number), 0) AS AOV,
    COUNT(DISTINCT sales.order_number) AS orders_count
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
WHERE YEAR(sales.order_date) < 2021
GROUP BY YEAR(sales.order_date))

SELECT
    time_year,
    revenue,
    AOV,
    orders_count,
    CONCAT(ROUND((revenue - LAG(revenue, 1) OVER (ORDER BY time_year)) / LAG(revenue, 1) OVER (ORDER BY time_year) * 100, 0), "%") AS revenue_growth,
    CONCAT(ROUND((AOV - LAG(AOV, 1) OVER (ORDER BY time_year)) / LAG(AOV, 1) OVER (ORDER BY time_year) * 100, 0), "%") AS AOV_growth,
    CONCAT(ROUND((orders_count - LAG(orders_count, 1) OVER (ORDER BY time_year)) / LAG(orders_count, 1) OVER (ORDER BY time_year) * 100, 0), "%") AS orders_growth
FROM performance;

-- Sales revenue, AOV and order growth rates by month
WITH performance AS (
SELECT
    YEAR(sales.order_date) AS time_year,
    MONTH(sales.order_date) AS time_month,
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS revenue,
    ROUND(SUM(products.unit_price_usd * sales.quantity) / COUNT(DISTINCT sales.order_number), 0) AS AOV,
    COUNT(DISTINCT sales.order_number) AS orders_count
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
WHERE YEAR(sales.order_date) < 2021
GROUP BY YEAR(sales.order_date), MONTH(sales.order_date))

SELECT
    time_year,
    time_month,
    revenue,
    AOV,
    orders_count,
    CONCAT(ROUND((revenue - LAG(revenue, 1) OVER (ORDER BY time_year, time_month)) / LAG(revenue, 1) OVER (ORDER BY time_year, time_month) * 100, 2), "%") AS revenue_growth,
    CONCAT(ROUND((AOV - LAG(AOV, 1) OVER (ORDER BY time_year, time_month)) / LAG(AOV, 1) OVER (ORDER BY time_year, time_month) * 100, 2), "%") AS AOV_growth,
    CONCAT(ROUND((orders_count - LAG(orders_count, 1) OVER (ORDER BY time_year, time_month)) / LAG(orders_count, 1) OVER (ORDER BY time_year, time_month) * 100, 2), "%") AS orders_growth
FROM performance;

-- Percentage of revenue by continent
WITH continent_revenue AS (
SELECT
    YEAR(sales.order_date) AS time_year,
    customers.continent AS continent,
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS revenue
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
LEFT JOIN customers ON customers.customer_key = sales.customer_key
WHERE YEAR(sales.order_date) < 2021
GROUP BY YEAR(sales.order_date), customers.continent),

total_revenue_by_year AS (
    SELECT
        time_year,
        SUM(revenue) AS total_revenue
    FROM continent_revenue
    GROUP BY time_year),

continent_revenue_pct AS(
SELECT
    continent_revenue.time_year,
    continent_revenue.continent,
    continent_revenue.revenue,
    CONCAT(ROUND(continent_revenue.revenue / total_revenue_by_year.total_revenue * 100, 2), "%") AS pct_revenue
FROM continent_revenue
JOIN total_revenue_by_year ON continent_revenue.time_year = total_revenue_by_year.time_year)

SELECT
    continent,
    ROUND(AVG(pct_revenue), 2) AS avg_pct_revenue
FROM continent_revenue_pct
GROUP BY continent
ORDER BY avg_pct_revenue DESC;

-- Revenue growth rate by continent
WITH continent_revenue AS (
SELECT
    YEAR(sales.order_date) AS time_year,
    customers.continent AS continent,
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS revenue
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
LEFT JOIN customers ON customers.customer_key = sales.customer_key
WHERE YEAR(sales.order_date) < 2021
GROUP BY YEAR(sales.order_date), customers.continent)

SELECT
    time_year,
    continent,
    revenue,
    CONCAT(ROUND((revenue - LAG(revenue, 3) OVER (ORDER BY time_year, continent)) / LAG(revenue, 3) OVER (ORDER BY time_year, continent) * 100, 0), "%") AS revenue_growth
FROM continent_revenue;

-- Average revenue, AOV and order by category
WITH performance AS (
SELECT
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS total_revenue,
    ROUND(SUM(products.unit_price_usd * sales.quantity) / COUNT(DISTINCT sales.order_number), 0) AS AOV,
    COUNT(DISTINCT sales.order_number) AS orders_count
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
WHERE YEAR(sales.order_date) < 2021),

category_performance AS (
SELECT
    products.category,
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS category_revenue,
    ROUND(SUM(products.unit_price_usd * sales.quantity) / COUNT(DISTINCT sales.order_number), 0) AS category_AOV,
    COUNT(DISTINCT sales.order_number) AS category_orders_count
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
WHERE YEAR(sales.order_date) < 2021
GROUP BY products.category)

SELECT
    category,
    category_revenue AS revenue,
    CONCAT(ROUND(category_revenue / total_revenue * 100, 1), "%") AS pct_revenue,
    category_AOV AS AOV,
    category_orders_count AS orders_count,
    CONCAT(ROUND(category_orders_count / orders_count * 100, 1), "%") AS pct_orders_count
FROM category_performance
CROSS JOIN performance
ORDER BY revenue DESC;

-- Average revenue, AOV and order growth rate by category

WITH category_performance AS (
    SELECT
        YEAR(sales.order_date) AS time_year,
        products.category,
        ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS revenue,
        ROUND(SUM(products.unit_price_usd * sales.quantity) / COUNT(DISTINCT sales.order_number), 0) AS AOV,
        COUNT(DISTINCT sales.order_number) AS orders_count
    FROM sales
    LEFT JOIN products ON products.product_key = sales.product_key
    WHERE YEAR(sales.order_date) < 2021
    GROUP BY time_year, products.category),

category_growth_rate AS(
SELECT
	time_year,
    category,
    revenue,
    AOV,
    orders_count,
    (revenue - LAG(revenue, 8) OVER (ORDER BY time_year, category)) / LAG(revenue, 8) OVER (ORDER BY time_year, category) AS revenue_growth,
    (AOV - LAG(AOV, 8) OVER (ORDER BY time_year, category)) / LAG(AOV, 8) OVER (ORDER BY time_year, category) AS AOV_growth,
    (orders_count - LAG(orders_count, 8) OVER (ORDER BY time_year, category)) / LAG(orders_count, 8) OVER (ORDER BY time_year, category) AS orders_growth
FROM category_performance)

SELECT
	category,
    CONCAT(ROUND(AVG(revenue_growth) * 100, 1), "%") AS average_revenue_growth,
    CONCAT(ROUND(AVG(AOV_growth) * 100, 1), "%") AS average_AOV_growth,
    CONCAT(ROUND(AVG(orders_growth) * 100, 1), "%") AS average_orders_growth
FROM category_growth_rate
GROUP BY category
ORDER BY CONCAT(ROUND(AVG(revenue_growth) * 100, 1), "%") DESC;

-- Average revenue, AOV and order by subcategory
WITH performance AS (
SELECT
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS total_revenue,
    ROUND(SUM(products.unit_price_usd * sales.quantity) / COUNT(DISTINCT sales.order_number), 0) AS AOV,
    COUNT(DISTINCT sales.order_number) AS orders_count
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
WHERE YEAR(sales.order_date) < 2021),

subcategory_performance AS (
SELECT
    products.category,
    products.subcategory,
    ROUND(SUM(products.unit_price_usd * sales.quantity), 0) AS subcategory_revenue,
    ROUND(SUM(products.unit_price_usd * sales.quantity) / COUNT(DISTINCT sales.order_number), 0) AS subcategory_AOV,
    COUNT(DISTINCT sales.order_number) AS subcategory_orders_count
FROM sales
LEFT JOIN products ON products.product_key = sales.product_key
WHERE YEAR(sales.order_date) < 2021
GROUP BY products.category, products.subcategory)

SELECT
    category,
    subcategory,
    subcategory_revenue AS revenue,
    CONCAT(ROUND(subcategory_revenue / total_revenue * 100, 1), "%") AS pct_revenue,
    subcategory_AOV AS AOV,
    subcategory_orders_count AS orders_count,
    CONCAT(ROUND(subcategory_orders_count / orders_count * 100, 1), "%") AS pct_orders_count
FROM subcategory_performance
CROSS JOIN performance
